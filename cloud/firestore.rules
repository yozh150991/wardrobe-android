rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/state/head {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['revision','archive','fingerprint','format','wardrobes','garments','outfits','updatedAt'])
          && d.keys().hasOnly(['revision','archive','fingerprint','format','wardrobes','garments','outfits','updatedAt'])
          && d.revision is int && d.revision > 0
          && d.archive is string && d.archive.matches('users/' + uid + '/snapshots/[a-f0-9-]{36}[.]zip')
          && d.fingerprint is string && d.fingerprint.matches('[a-f0-9]{64}')
          && d.format is int && d.format in [8, 9, 10]
          && d.wardrobes is int && d.wardrobes >= 0 && d.wardrobes <= 100000
          && d.garments is int && d.garments >= 0 && d.garments <= 100000
          && d.outfits is int && d.outfits >= 0 && d.outfits <= 100000
          && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid() && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.format >= resource.data.format;
      // Deleting/resetting the head would invalidate the devices' conflict bases.
      allow delete, list: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
