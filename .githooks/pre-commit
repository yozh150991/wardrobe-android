#!/bin/sh
set -eu
wardrobe_tools=$(CDPATH= cd -- "$(dirname -- "$0")/../tools" && pwd)
wardrobe_python=$(git config --local --get wardrobe.gitSafetyPython || :)
if [ -z "$wardrobe_python" ]; then
    echo '[Wardrobe Git Safety] Run install-git-safety.sh or install-git-safety.ps1 in this clone.' >&2
    exit 2
fi
exec "$wardrobe_python" "$wardrobe_tools/git_safety.py" pre-commit "$@"
